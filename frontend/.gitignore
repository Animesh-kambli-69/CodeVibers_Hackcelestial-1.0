# ============================================================
#  Smart Resort 360 — Frontend .gitignore (Vite + React)
# ============================================================

# ── Dependencies ───────────────────────────────────────────
node_modules/

# ── Build Output ───────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Vite Cache ─────────────────────────────────────────────
.vite/
.vite-cache/

# ── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test / Coverage ────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo

# ── OS Artifacts ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Storybook ──────────────────────────────────────────────
storybook-static/

# ── Temporary ──────────────────────────────────────────────
*.tmp
*.bak
