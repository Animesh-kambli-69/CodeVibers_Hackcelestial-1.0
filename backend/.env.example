# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_resort_360

# JWT Auth
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=86400

# ML Service URL (FastAPI with /api/v1/ml prefix)
ML_SERVICE_URL=http://localhost:8000/api/v1/ml

# LLM Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Resort Settings
RESORT_TIMEZONE=Asia/Kolkata
RESORT_LATITUDE=15.2993
RESORT_LONGITUDE=74.1240
RESORT_NAME=Smart Resort 360

# Weather Digital Twin (no API keys required — public endpoints)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
SOCIAL_SIGNAL_API_BASE_URL=https://hn.algolia.com/api/v1/search_by_date
SOCIAL_SIGNAL_QUERY=Goa weather travel resort
