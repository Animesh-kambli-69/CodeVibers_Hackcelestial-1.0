# ============================================================
#  Smart Resort 360 — Backend .gitignore
# ============================================================

# ── Dependencies ───────────────────────────────────────────
node_modules/

# ── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example

# ── Database files ─────────────────────────────────────────
# SQLite (dev only — never commit DB files)
*.sqlite
*.sqlite3
*.db

# PostgreSQL dump files
*.sql.gz
*.dump

# ── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Build / dist ───────────────────────────────────────────
dist/
build/

# ── OS Artifacts ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.sw?
*.swp

# ── Temporary ──────────────────────────────────────────────
*.tmp
*.bak
